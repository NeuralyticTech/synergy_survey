# Copy to .env.local for local development, and set the same keys in
# Vercel > Project > Settings > Environment Variables for production.

# ---------------------------------------------------------------------------
# Database — Neon Postgres (Vercel > Storage > Create Database > Neon)
# The Vercel integration injects DATABASE_URL automatically once connected.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Secrets — generate with: npm run keygen
#
# ENCRYPTION_KEY  32 bytes, base64. Encrypts every answer at rest.
#                 If this is lost, existing submissions cannot be recovered.
# EMAIL_HASH_KEY  32 bytes, base64. Keys the lookup hashes for addresses.
# SESSION_SECRET  48+ bytes. Signs the login cookies.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=""
EMAIL_HASH_KEY=""
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Email — Resend (https://resend.com), free tier: 3,000/month, 100/day
#
# EMAIL_FROM must be on a domain you have verified in Resend. Until you verify
# one, "onboarding@resend.dev" works but ONLY delivers to the address that owns
# the Resend account.
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Staff Check-in <checkin@yourverifieddomain.com.au>"

# Email Nigel / Michael when a response lands. Set to "false" to turn off.
NOTIFY_ON_SUBMIT="true"

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Comma-separated. These are the ONLY addresses that can open /results.
RESULTS_ALLOWED_EMAILS="mbailey@synergymanaged.com.au,nigel@portaltechnology.com.au"

# Optional extra staff domains, as domain:company pairs.
# e.g. ALLOWED_EMAIL_DOMAINS="portaltechnology.au:portal"
ALLOWED_EMAIL_DOMAINS=""

# ---------------------------------------------------------------------------
# Public URL used to build links inside emails.
# On Vercel this is inferred; set it explicitly once you attach a real domain.
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
